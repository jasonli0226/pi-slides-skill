{
  "name": "web-slides-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "review": "node scripts/review.mjs",
    "export:pdf": "node scripts/export-pdf.mjs",
    "export:png": "node scripts/review.mjs --out export/png --no-lint",
    "verify": "npm run check:tokens && npm run build && node scripts/review.mjs --no-build && node scripts/export-pdf.mjs --no-build",
    "outline": "node scripts/watch-outline.mjs",
    "live": "node scripts/live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide-react": "^1.68.0",
    "mermaid": "^12.3.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
