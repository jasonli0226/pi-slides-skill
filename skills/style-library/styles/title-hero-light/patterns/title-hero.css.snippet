/* Reference — already in template deck.css; do not duplicate into brand.css */
.frame-title-hero { /* left copy, full-bleed backdrop via .title-backdrop */ }
.title-scrim-light {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.92) 0%,
    rgba(255, 255, 255, 0.78) 42%,
    rgba(255, 255, 255, 0.15) 62%,
    transparent 78%
  );
}
.title-scrim-dark {
  background: linear-gradient(
    90deg,
    rgba(6, 10, 20, 0.88) 0%,
    rgba(6, 10, 20, 0.55) 45%,
    transparent 72%
  );
}
